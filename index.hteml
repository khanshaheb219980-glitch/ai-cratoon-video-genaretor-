<!DOCTYPE html> <html lang="en"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>AI Cartoon Video Generator</title> <style> * { box-sizing: border-box; } body { margin: 0; font-family: Arial, sans-serif; background: linear-gradient(135deg, #10172a, #263b68); color: white; min-height: 100vh; } header { text-align: center; padding: 30px 15px; background: #0b1020; } header h1 { color: #62e8ff; } .container { max-width: 700px; margin: 35px auto; padding: 25px; background: rgba(255, 255, 255, 0.08); border-radius: 18px; } label { display: block; margin: 18px 0 8px; font-weight: bold; } textarea, select { width: 100%; padding: 13px; border: 1px solid #65749b; border-radius: 9px; font-size: 16px; } textarea { min-height: 130px; } button { width: 100%; padding: 15px; margin-top: 20px; border: none; border-radius: 9px; background: #20d6c7; font-weight: bold; cursor: pointer; } #result { margin-top: 20px; padding: 15px; background: #0b1020; border-radius: 9px; line-height: 1.6; overflow-wrap: anywhere; } footer { text-align: center; padding: 20px; color: #d1d9ee; }
